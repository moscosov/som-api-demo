    {
      "name": "2. Órdenes",
      "item": [
        {
          "name": "Crear ALTA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://{{host}}/api/v2/ordenes",
              "protocol": "http",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "v2",
                "ordenes"
              ]
            },
            "description": "Respuesta esperada: 201 con la orden en RECIBIDA y el subscription_id de la nueva suscripción. El test guarda 'id_alta' y 'subscription_id'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_orden\": \"ALTA\",\n  \"com_id\": \"{{com_alta}}\",\n  \"cliente_id\": \"{{cliente_id}}\",\n  \"tipo_servicio\": \"INTERNET\",\n  \"offer_id\": \"200102\",\n  \"descripcion\": \"Alta de Fibra 600 Mbps residencial\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// com_id de 7 digitos, distinto en cada ejecucion para poder repetir la coleccion",
                  "pm.collectionVariables.set(\"com_alta\", String(Math.floor(1000000 + Math.random() * 9000000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"id_alta\", pm.response.json().id);",
                  "pm.collectionVariables.set(\"subscription_id\", pm.response.json().subscription_id);"
                ]
              }
            }
          ]
        },
