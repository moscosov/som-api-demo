              "raw": "http://{{host}}/api/v2/ofertas?q=fibra&limit=1",
              "protocol": "http",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "v2",
                "ofertas"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "fibra"
                },
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            },
            "description": "Respuesta esperada: 200 con un arreglo de a lo más una oferta cuyo nombre contiene 'fibra'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ofertas de TV (credencial en la URL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{host}}/api/v2/ofertas?tipo_servicio=TV&key={{token}}",
              "protocol": "http",
