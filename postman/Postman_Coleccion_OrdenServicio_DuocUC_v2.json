            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Tres ofertas de TV\", function () { pm.expect(pm.response.json().length).to.eql(3); });"
                ]
              }
